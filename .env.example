# Copy to .env for local development. Never commit real values.
# On Railway, set these as service variables instead.

# Railway: reference the Postgres service, e.g. ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/digisound
DATABASE_URL_TEST=postgresql+asyncpg://postgres:postgres@localhost:5432/digisound_test

# Secrets: generate your own long random values; leave blank here.
API_KEY=
READ_API_KEY=

SOURCE_BASE_URL=https://www.digisound.ee
HTTP_CONCURRENCY=2
HTTP_TIMEOUT_SECONDS=20
REQUEST_DELAY_MS=500

# Schedules are evaluated in SCHEDULE_TIMEZONE (IANA name). Empty cron disables a schedule.
DISCOVERY_CRON=0 2 * * *
STOCK_CRON=0 */4 * * *
SCHEDULE_TIMEZONE=UTC

# true = worker enqueues exactly one discovery job if none has ever existed
BOOTSTRAP_DISCOVERY=false
MAX_CATEGORY_DEPTH=4

# web | worker | all (all = API + worker in one service)
SERVICE_ROLE=all
ENVIRONMENT=production
