# PostgreSQL Database URLs (asyncpg for SQLAlchemy)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/digisound
DATABASE_URL_TEST=postgresql+asyncpg://postgres:postgres@localhost:5432/digisound_test

# Authentication Keys
# API_KEY is mandatory for job trigger endpoints (POST /api/jobs/*)
API_KEY=test-secret-key-change-in-production
# READ_API_KEY is optional; if unset, GET endpoints are publicly accessible
# READ_API_KEY=optional-read-key

# Source Configuration
SOURCE_BASE_URL=https://www.digisound.ee

# HTTP Client Settings
HTTP_CONCURRENCY=3
HTTP_TIMEOUT_SECONDS=20.0
REQUEST_DELAY_MS=500
USER_AGENT=DigisoundScraper/1.0 (+https://github.com/soundimports/digisound-car-audio-scraper)

# Worker Scheduling (cron syntax: minute hour day month day-of-week)
DISCOVERY_CRON=0 2 * * *
STOCK_CRON=0 */4 * * *

# Deployment Environment (development | testing | production)
ENVIRONMENT=development
